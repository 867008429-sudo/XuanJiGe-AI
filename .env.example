# 玄机阁 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key (必填，不填则AI解读不可用，排盘正常)
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek模型
# 默认推荐 deepseek-v4-flash，适合中文长文本输出；需要更强推理可改为 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# V4思考模式：文字输出默认关闭，流式响应更快；reasoning_effort 仅在开启时生效
# DEEPSEEK_THINKING=0
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=6000

# 服务端口 (默认8888)
PORT=8888

# 数据库路径 (Docker中默认 /app/data/xuanjige.db)
# DB_PATH=/app/data/xuanjige.db

# Flask Debug模式 (生产环境务必为0)
FLASK_DEBUG=0
