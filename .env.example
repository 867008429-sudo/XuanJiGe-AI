# 玄机阁 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key (必填，不填则AI解读不可用，排盘正常)
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek模型
# 默认推荐 deepseek-v4-flash，适合中文长文本输出；需要更强推理可改为 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# V4思考模式：文字输出默认关闭，流式响应更快；reasoning_effort 仅在开启时生效
# DEEPSEEK_THINKING=0
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=6000
# 网络/限流类短暂失败的有限重试次数
# DEEPSEEK_MAX_RETRIES=1

# 结构化生成：先让模型产出JSON分析骨架，再流式扩写正文，提高解读稳定性
# DEEPSEEK_STRUCTURED_GENERATION=1
# DEEPSEEK_STRUCTURE_MAX_TOKENS=3200
# DEEPSEEK_STRUCTURE_TEMPERATURE=0.25
# 结构化骨架未通过校验时，最多让模型按错误原因修复2次
# DEEPSEEK_STRUCTURE_REPAIR_RETRIES=2

# 注册防滥用：生产环境建议开启体验码，多个码用英文逗号分隔
# REGISTRATION_INVITE_CODES=demo-code-1,demo-code-2
# REGISTRATION_RATE_WINDOW_MINUTES=60
# REGISTRATION_RATE_MAX_ATTEMPTS=8
# REGISTRATION_DAILY_MAX_PER_IP=2
# REGISTRATION_DAILY_MAX_PER_CLIENT=1

# 管理统计：设置后才能访问 /api/stats；生产环境请使用高强度随机值
# ADMIN_TOKEN=replace-with-a-long-random-admin-token

# 日志：默认输出到控制台；配置 LOG_FILE 后会同时写入文件
# LOG_LEVEL=INFO
# LOG_FILE=/app/logs/xuanjige.log

# CORS来源白名单：有正式域名后建议配置；多个来源用英文逗号分隔
# ALLOWED_ORIGINS=https://your-domain.com

# 服务端口 (默认8888)
PORT=8888

# 数据库路径 (Docker中默认 /app/data/xuanjige.db)
# DB_PATH=/app/data/xuanjige.db

# chat 追问链路（LangGraph agent）
# 追问对话的 checkpoint 数据库（与主库分离，WAL 模式）
# CHAT_DB_PATH=/app/data/chat.db
# 每个命盘的免费香火（炷）；1 炷 = flash 档短回复的均值成本锚点，
# 缺省道长清虚 2 炷/问，10 炷 ≈ 旧"每盘 5 次追问"（persona-plan §3）
# CHAT_FREE_INCENSE=10
# 单条追问的输入长度上限（字符）
# CHAT_MAX_INPUT_CHARS=500
# 追问模型（缺省复用 DEEPSEEK_MODEL）与运行参数
# CHAT_MODEL=deepseek-v4-flash
# CHAT_API_BASE=https://api.deepseek.com
# CHAT_MAX_TOKENS=1500
# CHAT_TEMPERATURE=0.7
# CHAT_RECURSION_LIMIT=25
# CHAT_BUSY_TIMEOUT_MS=5000
# 生产环境默认每日清理 30 天以上的 chat checkpoint / 幂等回放 / 观测日志；
# 香火额度不重置，避免 retention cleanup 被当成免费额度刷新。
# CHAT_CLEANUP_ENABLED=1
# CHAT_CLEANUP_RETENTION_DAYS=30
# CHAT_CLEANUP_INTERVAL_SECONDS=86400
# CHAT_CLEANUP_INITIAL_DELAY_SECONDS=300

# SQLite备份目录；可配合 crontab 每日执行 tools/backup_sqlite.py
# BACKUP_DIR=/app/backups

# Flask Debug模式 (生产环境务必为0)
FLASK_DEBUG=0
